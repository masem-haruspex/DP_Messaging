# spring.jpa.properties.hibernate.format_sql=true

# RabbitMQ
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=${RABBITMQ_USERNAME}
spring.rabbitmq.password=${RABBITMQ_PASSWORD}

rabbitmq.exchange.user=user.exchange
rabbitmq.exchange.rooms=rooms.exchange

rabbitmq.routingkey.user.created=user.created
rabbitmq.routingkey.user.updated=user.updated

rabbitmq.routingkey.room.created=room.created
rabbitmq.routingkey.room.deleted=room.deleted
rabbitmq.routingkey.user.joined=user.joined
rabbitmq.routingkey.user.left=user.left
rabbitmq.routingkey.user.kicked=user.kicked
rabbitmq.routingkey.user.muted=user.muted
rabbitmq.routingkey.message.sent=message.sent

rabbitmq.queue.user.created=messaging.user.created.queue
rabbitmq.queue.user.updated=messaging.user.updated.queue
rabbitmq.queue.room.created=messaging.room.created.queue
rabbitmq.queue.room.deleted=messaging.room.deleted.queue
rabbitmq.queue.user.joined=messaging.user.joined.queue
rabbitmq.queue.user.left=messaging.user.left.queue
rabbitmq.queue.user.kicked=messaging.user.kicked.queue
rabbitmq.queue.user.muted=messaging.user.muted.queue
rabbitmq.queue.message.sent=messaging.message.sent.queue

# Actuator
management.server.port=9003
management.server.address=127.0.0.1
management.endpoints.web.exposure.include=health,info,metrics,loggers
management.endpoint.health.show-details=always
management.endpoint.loggers.enabled=true

# OpenAPI
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.path=/swagger-ui.html
